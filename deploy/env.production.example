# CIMS production settings (the server's /var/www/cims/.env).
# install-release.sh fills in the lines marked [auto] on the first install.
# After changing anything here:  sudo systemctl reload php8.1-fpm
#
# Do NOT run `php artisan config:cache` on this server: some CIMS code reads
# these values directly (SMS via Twilio, the mysqldump backup), and cached
# config makes those reads return nothing.

APP_NAME="CIMS"
APP_ENV=production
APP_DEBUG=false
# [auto] Must be the SAME key as the computer CIMS ran on before: SMTP and
# Xendit secrets in the database are encrypted with it.
APP_KEY=
# [auto] https://your-domain
APP_URL=

# The shop trades in Philippine time; DB_TIMEZONE must be its offset.
APP_TIMEZONE=Asia/Manila
DB_TIMEZONE=+08:00

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cims
DB_USERNAME=cims
# [auto] from /root/cims-db-password
DB_PASSWORD=
DUMP_PATH=/usr/bin/mysqldump

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Cookies only over HTTPS.
SESSION_SECURE_COOKIE=true

# Email is set in CIMS under Settings > SMTP; this is only the fallback.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# SMS (optional)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

MULTI_TENANT=false

# GCash / Maya at the POS. The Xendit keys are entered in CIMS under
# Settings > Payment Gateway (stored encrypted). "fake" is a stand-in that
# takes no money: set xendit once the keys are in, and point Xendit's
# webhook at https://your-domain/api/xendit/webhook
WALLET_DRIVER=fake
