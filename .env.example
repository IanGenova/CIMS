APP_NAME="CIMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
# The shop trades in Philippine time. MySQL stores the digits it is
# handed and remembers no zone, so this is what decides what those
# digits mean -- on the receipts, the Z-readings and the books.
APP_TIMEZONE=Asia/Manila
# Must be the offset of APP_TIMEZONE. The Philippines has no summer time.
DB_TIMEZONE=+08:00

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cims
DB_USERNAME=root
DB_PASSWORD=

DUMP_PATH=mysqldump
BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

STRIPE_KEY=
STRIPE_SECRET=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Initial administrator created by db:seed
CIMS_ADMIN_FIRSTNAME=System
CIMS_ADMIN_LASTNAME=Administrator
CIMS_ADMIN_NAME="System Administrator"
CIMS_ADMIN_EMAIL=admin@example.com
CIMS_ADMIN_PASSWORD="ChangeMe123!"
CIMS_ADMIN_PHONE=
